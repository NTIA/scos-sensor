ARG BASE_IMAGE
FROM $BASE_IMAGE

RUN apt-get update -q && \
    DEBIAN_FRONTEND=noninteractive \
                   apt-get install -qy --no-install-recommends \
				   build-essential python3 python3-pip python3-venv python3-dev \
                   libusb-1.0-0 \
                   git smartmontools \
                   usbutils && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create a virtual environment and update PATH to use it by default
RUN test -d /opt/venv || python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

ENV PYTHONUNBUFFERED=1
RUN mkdir -p /src
WORKDIR /src
COPY ./src/requirements.txt /src
COPY ./src/requirements-dev.txt /src

ARG DOCKER_GIT_CREDENTIALS
RUN git config --global credential.helper store && echo "${DOCKER_GIT_CREDENTIALS}" > ~/.git-credentials
RUN /opt/venv/bin/python -m pip install --upgrade pip
ARG DEBUG
RUN if [ "$DEBUG" = true ]; then  /opt/venv/bin/python  -m pip install --no-cache-dir -r requirements-dev.txt ; else  /opt/venv/bin/python  -m pip install --no-cache-dir -r requirements.txt ; fi

COPY ./src /src
COPY ./gunicorn /gunicorn

RUN mkdir -p /entrypoints
COPY ./entrypoints/api_entrypoint.sh /entrypoints

RUN chmod +x /entrypoints/api_entrypoint.sh

COPY ./configs /configs

# Args are passed in via docker-compose during build time
ARG DOMAINS
ARG IPS
ARG SECRET_KEY
